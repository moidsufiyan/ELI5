# ELI5 AI Simplifier Environment Variables
#
# IMPORTANT: This app works perfectly in DEMO MODE without any API key!
# The mock responses are designed to showcase all functionality.
#
# Google Gemini AI API Key (OPTIONAL)
# Get your API key from: https://aistudio.google.com/app/apikey
# Old URL (makersuite) is deprecated - use the new aistudio URL above
#
# To enable real AI, uncomment and add your key:
# GEMINI_API_KEY=your_actual_api_key_here

# Leave empty or commented to use DEMO MODE (recommended for testing)
GEMINI_API_KEY=

# Development environment
NODE_ENV=development
